(function () {
  function loadLibrary(urls, checkLibrary, onReady, onFail) {
    let index = 0;

    function tryNext() {
      if (checkLibrary()) {
        onReady();
        return;
      }

      if (index >= urls.length) {
        onFail();
        return;
      }

      const script = document.createElement("script");
      script.src = urls[index++];
      script.async = true;

      script.onload = function () {
        if (checkLibrary()) {
          onReady();
        } else {
          script.remove();
          tryNext();
        }
      };

      script.onerror = function () {
        script.remove();
        tryNext();
      };

      document.head.appendChild(script);
    }

    tryNext();
  }

  loadLibrary(
    [
      "https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js",
      "https://unpkg.com/xlsx@0.18.5/dist/xlsx.full.min.js"
    ],
    () => !!(window.XLSX && window.XLSX.read && window.XLSX.utils),
    () => {
      window.__xlsxReady = true;
      document.dispatchEvent(new Event("xlsx-ready"));
    },
    () => {
      window.__xlsxFailed = true;
      document.dispatchEvent(new Event("libraries-failed"));
    }
  );

  loadLibrary(
    [
      "https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js",
      "https://cdn.jsdelivr.net/npm/qrcodejs@1.0.0/qrcode.min.js"
    ],
    () => typeof window.QRCode === "function",
    () => {
      window.__qrReady = true;
      document.dispatchEvent(new Event("qr-ready"));
    },
    () => {
      window.__qrFailed = true;
      document.dispatchEvent(new Event("libraries-failed"));
    }
  );
})();

document.addEventListener("keydown", function (event) {
  // Bỏ qua phím điều hướng khi đang nhập liệu
  const target = event.target;
  const tag = target && target.tagName
    ? target.tagName.toLowerCase()
    : "";

  if (
    tag === "input" ||
    tag === "textarea" ||
    tag === "select" ||
    (target && target.isContentEditable)
  ) {
    return;
  }

  // Lấy các dòng dữ liệu hiện đang hiển thị
  const tableWrap = document.getElementById("tableWrap");
  if (!tableWrap) return;

  const rows = Array.from(
    tableWrap.querySelectorAll("tbody tr")
  ).filter(row =>
    row.querySelectorAll("td").length > 0 &&
    row.offsetParent !== null
  );

  if (!rows.length) return;

  // Tìm dòng đang được chọn
  let current = rows.findIndex(row =>
    row.classList.contains("selected")
  );

  let next = current;

  switch (event.key) {
    case "ArrowDown":
      next = current < 0 ? 0 : Math.min(current + 1, rows.length - 1);
      break;

    case "ArrowUp":
      next = current < 0 ? 0 : Math.max(current - 1, 0);
      break;

    case "Home":
      next = 0;
      break;

    case "End":
      next = rows.length - 1;
      break;

    default:
      return;
  }

  event.preventDefault();

  // Kích hoạt chọn bill theo logic sẵn có của bảng
  rows[next].click();

  rows[next].scrollIntoView({
    behavior: "auto",
    block: "nearest"
  });
});

</script>


