<!doctype html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#b91c1c">
  <title>Trình Tạo QR_KIEN</title>
  
<script src="https://cdn.jsdelivr.net/npm/qrcode@1.5.4/build/qrcode.min.js"></script>

  <style>
    :root{--red:#b91c1c;--red-dark:#991b1b;--ink:#172033;--muted:#64748b;--line:#e2e8f0;--soft:#f8fafc;--white:#fff;--green:#15803d}
    *{box-sizing:border-box}
    body{margin:0;background:#f1f5f9;color:var(--ink);font:14px/1.5 Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    button,input,select{font:inherit}
    button{cursor:pointer}
    .topbar{background:linear-gradient(120deg,#991b1b,#dc2626);color:#fff;padding:22px max(20px,calc((100% - 1500px)/2));box-shadow:0 4px 16px #7f1d1d22}
    .brand{display:flex;align-items:center;gap:14px}.logo{width:48px;height:48px;display:grid;place-items:center;border:1px solid #ffffff66;background:#ffffff18;border-radius:14px;font-size:26px}
    h1{font-size:23px;line-height:1.2;margin:0 0 5px;letter-spacing:.2px}.subtitle{color:#fee2e2;margin:0;font-size:13px}
    main{max-width:1500px;margin:22px auto;padding:0 20px 30px}
    .toolbar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-bottom:16px}
    .toolbar-left,.toolbar-right{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
    .btn{border:1px solid var(--line);background:#fff;color:var(--ink);padding:10px 14px;border-radius:10px;font-weight:650;display:inline-flex;align-items:center;gap:8px;justify-content:center;transition:.15s}
    .btn:hover{border-color:#cbd5e1;background:#f8fafc}.btn.primary{background:var(--red);border-color:var(--red);color:#fff}.btn.primary:hover{background:var(--red-dark)}
    .btn:disabled{opacity:.45;cursor:not-allowed}
    .file-label{position:relative;overflow:hidden}.file-label input{position:absolute;inset:0;opacity:0;cursor:pointer;width:100%}
    .status{font-size:12px;color:var(--muted)}
    .stats{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-bottom:16px}
    .stat{background:#fff;border:1px solid var(--line);border-radius:13px;padding:14px 16px;display:flex;align-items:center;gap:12px}
    .stat-icon{width:40px;height:40px;display:grid;place-items:center;border-radius:11px;background:#fee2e2;color:var(--red);font-size:20px}
    .stat strong{display:block;font-size:21px;line-height:1.2}.stat span{color:var(--muted);font-size:12px}
    .workspace{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:16px;align-items:start}
    .panel{background:#fff;border:1px solid var(--line);border-radius:15px;overflow:hidden;min-width:0}
    .panel-head{padding:15px 17px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
    .panel-title{font-size:15px;font-weight:750;margin:0}.panel-desc{font-size:12px;color:var(--muted);margin:3px 0 0}
    .table-tools{display:flex;gap:8px;flex-wrap:wrap;padding:12px 15px;border-bottom:1px solid var(--line);background:#fbfdff}
    .search{flex:1;min-width:170px;position:relative}.search input{width:100%;padding:9px 12px 9px 35px;border:1px solid var(--line);border-radius:9px;outline:none;background:white}.search input:focus,select:focus{border-color:#f87171;box-shadow:0 0 0 3px #fee2e2}
    .search span{position:absolute;left:12px;top:7px;color:var(--muted);font-size:16px}
    select{max-width:220px;min-width:150px;padding:9px 10px;border:1px solid var(--line);border-radius:9px;background:white;color:var(--ink);outline:none}
    .table-wrap{overflow:auto;max-height:64vh;min-height:300px}
    table{border-collapse:separate;border-spacing:0;width:max-content;min-width:100%;font-size:13px}
    th,td{padding:10px 13px;border-right:1px solid #edf1f5;border-bottom:1px solid #e8edf3;text-align:left;white-space:nowrap;max-width:300px;overflow:hidden;text-overflow:ellipsis}
    th{position:sticky;top:0;background:#f8fafc;color:#475569;font-weight:750;z-index:1}
    tbody tr{cursor:pointer}tbody tr:hover td{background:#fff7f7}tbody tr.selected td{background:#fff1f2}tbody tr.selected td:first-child{box-shadow:inset 3px 0 var(--red)}
    .rownum{color:#94a3b8;text-align:right;background:#fafafa;min-width:46px}
    .bill-cell{font-weight:750;color:#991b1b}
    .empty{min-width:100%;padding:60px 20px;text-align:center;color:var(--muted)}.empty .emoji{font-size:36px;margin-bottom:10px}
    .table-foot{padding:10px 15px;display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;color:var(--muted);font-size:12px}
    .qr-panel{position:sticky;top:14px}
    .qr-body{padding:18px;display:flex;flex-direction:column;align-items:center;text-align:center}
    .qr-placeholder{width:210px;height:210px;border:1px dashed #cbd5e1;border-radius:15px;display:grid;place-items:center;color:#94a3b8;background:#fafafa;margin:4px 0 15px}
   #qrCanvas{
  width:210px;
  height:210px;
  display:none;
  padding:9px;
  background:#fff;
  border:1px solid #e2e8f0;
  border-radius:13px;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}

#qrCanvas canvas,
#qrCanvas img{
  display:block;
  width:100% !important;
  height:100% !important;
  max-width:100%;
  max-height:100%;
  object-fit:contain;
}
    .selected-label{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:var(--muted);font-weight:750}
    .bill-value{font-size:20px;font-weight:800;overflow-wrap:anywhere;margin:5px 0 2px}
    .qr-note{font-size:12px;color:var(--muted);margin:0 0 15px}
    .qr-actions{width:100%;display:grid;grid-template-columns:1fr 1fr;gap:8px}.qr-actions .btn{padding:9px 8px;font-size:12px}
    .detail{width:100%;text-align:left;border-top:1px solid var(--line);margin-top:18px;padding-top:13px}
    .detail-row{display:flex;justify-content:space-between;gap:12px;padding:6px 0;font-size:12px}.detail-row span:first-child{color:var(--muted)}.detail-row span:last-child{font-weight:650;text-align:right;max-width:60%;overflow-wrap:anywhere}
    .tip{margin-top:15px;background:#fff7ed;border:1px solid #fed7aa;color:#9a3412;padding:12px 14px;border-radius:11px;font-size:12px}
    .footer{text-align:center;color:#94a3b8;font-size:12px;padding:20px 0 0}
    .toast{position:fixed;right:20px;bottom:20px;background:#172033;color:white;padding:12px 16px;border-radius:10px;box-shadow:0 10px 30px #0002;z-index:20;max-width:min(420px,calc(100vw - 40px));display:none}
    @media(max-width:980px){.workspace{grid-template-columns:minmax(0,1fr) 280px}.qr-placeholder,#qrCanvas{width:180px;height:180px}}
    @media(max-width:760px){main{padding:0 12px 22px;margin-top:14px}.topbar{padding:18px 15px}.workspace{grid-template-columns:1fr}.qr-panel{position:static;grid-row:1}.qr-body{padding:14px}.qr-placeholder,#qrCanvas{width:170px;height:170px}.stats{gap:8px}.stat{padding:11px}.stat strong{font-size:18px}.stat-icon{width:34px;height:34px}.table-wrap{max-height:55vh;min-height:220px}h1{font-size:20px}}
    @media(max-width:420px){.stats{grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.stat{padding:9px 7px;gap:6px;align-items:flex-start}.stat strong{font-size:16px}.stat span{font-size:10px;line-height:1.25;display:block}.stat-icon{display:none}.toolbar-left,.toolbar-right{width:100%}.toolbar-left .btn,.toolbar-right .btn{flex:1;min-width:0}.topbar{padding:16px 13px}.logo{width:42px;height:42px;font-size:23px}h1{font-size:19px}.subtitle{font-size:12px}}
    @media(max-width:600px){
      body{font-size:14px}
      .toolbar{gap:8px}
      .toolbar-left{display:grid;grid-template-columns:1fr 1fr;gap:8px}
      .toolbar-left .file-label{grid-column:1 / -1}
      .btn{min-height:44px;padding:10px 11px;font-size:13px}
      .file-label{width:100%}
      .toolbar-right{padding:0 2px}
      .stats{margin-bottom:10px}
      .workspace{gap:12px}
      .qr-panel{order:0}
      .table-panel{order:1}
      .panel{border-radius:12px}
      .panel-head{padding:12px}
      .panel-desc{font-size:11px}
      .table-tools{padding:10px;display:grid;grid-template-columns:1fr;gap:8px}
      .search{min-width:0;width:100%}
      .search input,select{width:100%;max-width:none;min-height:44px}
      .table-wrap{overflow:visible;max-height:none;min-height:0;padding:8px;background:#f8fafc}
      table{width:100%;min-width:0;border-collapse:separate;border-spacing:0 8px;font-size:13px}
      thead{display:none}
      tbody{display:block;width:100%}
      tbody tr{display:block;background:#fff;border:1px solid var(--line);border-radius:10px;overflow:hidden;margin:0 0 8px;box-shadow:0 1px 2px #0f172a08}
      tbody tr.selected{border:1.5px solid #f87171;box-shadow:0 0 0 2px #fee2e2}
      tbody td{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;width:100%;max-width:none;white-space:normal;overflow-wrap:anywhere;text-overflow:clip;padding:9px 10px;border-right:0;border-bottom:1px solid #f1f5f9;text-align:right}
      tbody td:last-child{border-bottom:0}
      tbody td::before{content:attr(data-label);color:var(--muted);font-size:11px;font-weight:650;text-align:left;flex:0 0 36%;overflow-wrap:anywhere}
      tbody td.rownum{display:none}
      tbody td.bill-cell{font-size:14px;background:#fff7f7;color:var(--red-dark)}
      tbody td.bill-cell::before{color:var(--red-dark)}
      .empty{padding:35px 14px;min-width:0}
      .table-foot{padding:10px;display:grid;gap:4px}
      .qr-body{padding:14px}
      .qr-placeholder,#qrCanvas{width:min(66vw,220px);height:min(66vw,220px)}
      .bill-value{font-size:19px;max-width:100%}
      .qr-actions{gap:8px}
      .qr-actions .btn{font-size:12px;min-height:46px}
      .detail{margin-top:14px}
      .detail-row{font-size:12px;gap:8px}
      .detail-row span:first-child{max-width:42%;overflow-wrap:anywhere}
      .detail-row span:last-child{max-width:58%}
      .tip{font-size:11px;padding:10px 12px}
    }
    @media print{body{background:#fff}.topbar,main>.toolbar,main>.stats,.table-panel,.tip,.footer,.panel-head,.qr-actions,.detail{display:none!important}main{margin:0;padding:0}.workspace{display:block}.qr-panel{position:static;border:0}.qr-body{padding:0}.qr-placeholder{display:none!important}#qrCanvas{display:block!important;width:260px;height:260px;border:0}.selected-label,.qr-note{color:#333}}
  
/* ===== INTRO BILL QR MANAGER ===== */
#vpostIntro {
  position: fixed;
  inset: 0;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  padding: 24px;
  color: #fff;
  background:
    radial-gradient(ellipse at 75% 30%, #ef4444 0%, transparent 38%),
    linear-gradient(135deg, #450a0a 0%, #991b1b 48%, #dc2626 100%);
  font-family: Inter, system-ui, sans-serif;
  opacity: 1;
  visibility: visible;
  transition: opacity .55s ease, visibility .55s ease;
}

#vpostIntro.intro-exit {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

#vpostIntro * {
  box-sizing: border-box;
}

#vpostIntro .intro-content {
  position: relative;
  width: min(900px, 100%);
  text-align: center;
  z-index: 2;
}

#vpostIntro .intro-brand {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 8px 15px;
  border: 1px solid #ffffff50;
  border-radius: 999px;
  background: #ffffff12;
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 2px;
  animation: vpFadeDown .7s both;
}

#vpostIntro .intro-brand-icon {
  display: grid;
  place-items: center;
  width: 30px;
  height: 30px;
  background: #fff;
  color: #b91c1c;
  border-radius: 8px;
  font-size: 19px;
}

#vpostIntro .intro-title {
  margin: 25px 0 12px;
  font-size: clamp(28px, 5vw, 51px);
  line-height: 1.15;
  font-weight: 900;
  letter-spacing: -.8px;
  color: #fff;
  animation: vpFadeUp .8s .1s both;
}

#vpostIntro .intro-title span {
  color: #fecaca;
}

#vpostIntro .intro-desc {
  max-width: 600px;
  margin: 0 auto;
  color: #fee2e2;
  font-size: clamp(14px, 2vw, 17px);
  line-height: 1.8;
  animation: vpFadeUp .8s .2s both;
}

#vpostIntro .intro-scene {
  position: relative;
  width: min(660px, 100%);
  height: 230px;
  margin: 22px auto 20px;
  overflow: hidden;
  border: 1px solid #ffffff30;
  border-radius: 22px;
  background: linear-gradient(180deg, #ffffff13, #450a0a20);
  animation: vpFadeUp .8s .25s both;
}

#vpostIntro .intro-grid {
  position: absolute;
  inset: 0;
  opacity: .16;
  background-image:
    linear-gradient(#fff 1px, transparent 1px),
    linear-gradient(90deg, #fff 1px, transparent 1px);
  background-size: 28px 28px;
}

#vpostIntro .intro-road {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 25px;
  height: 5px;
  background: #ffffff65;
}

#vpostIntro .intro-road:after {
  content: "";
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(
    90deg, transparent 0 25px, #fff 25px 48px
  );
  animation: vpRoad 1s linear infinite;
}


/* ===== XE TẢI VIETTEL POST - CSS NÂNG CẤP ===== */


/* ===== XE TẢI VIETTEL POST - PHIÊN BẢN NÂNG CẤP ===== */

#vpostIntro .intro-truck {
  position: absolute;
  left: -260px;
  bottom: 28px;
  width: 250px;
  height: 112px;
  animation: vpTruck 5.2s .4s ease-in-out both;
  filter: drop-shadow(0 6px 3px rgba(30,0,0,.28));
}

/* Bóng xe trên mặt đường */
#vpostIntro .intro-truck::after {
  content: "";
  position: absolute;
  z-index: 0;
  left: 12px;
  bottom: 1px;
  width: 226px;
  height: 11px;
  border-radius: 50%;
  background: #25060666;
  filter: blur(5px);
}

/* Thùng hàng đỏ */
#vpostIntro .truck-body {
  position: absolute;
  z-index: 2;
  left: 3px;
  bottom: 25px;
  width: 157px;
  height: 67px;
  overflow: visible;
  border: 1px solid #a20c20;
  border-radius: 2px 2px 1px 1px;
  background:
    linear-gradient(90deg,
      #ffffff12 0%,
      transparent 18%,
      #a9001b18 100%),
    linear-gradient(180deg,
      #ff554b 0%,
      #ed2635 35%,
      #d71930 72%,
      #b50e27 100%);
  box-shadow:
    inset 0 3px 0 #ffffff30,
    inset 3px 0 5px #ffffff12,
    inset -5px 0 6px #72091c35,
    inset 0 -4px 0 #8f0b20;
}

/* Thanh kim loại trên nóc */
#vpostIntro .truck-roof {
  position: absolute;
  left: -2px;
  top: -5px;
  width: calc(100% + 3px);
  height: 5px;
  border: 1px solid #aab2bb;
  border-radius: 2px 2px 0 0;
  background: linear-gradient(#ffffff, #c7cdd4 55%, #929ba5);
  box-shadow: 0 1px 1px #55000b55;
}

/* Các đường gân dọc của thùng */
#vpostIntro .truck-ribs {
  position: absolute;
  inset: 3px 5px 4px 4px;
  opacity: .42;
  background: repeating-linear-gradient(
    90deg,
    transparent 0 18px,
    #8b071a55 19px,
    #ffffff18 20px,
    transparent 22px
  );
  border-right: 2px solid #8d0b1c66;
  pointer-events: none;
}

/* Sọc nhận diện màu trắng */
#vpostIntro .truck-stripe {
  position: absolute;
  z-index: 2;
  left: 0;
  bottom: 8px;
  width: 100%;
  height: 8px;
  background: linear-gradient(
    180deg,
    #ffffff 0%,
    #f1f3f5 55%,
    #cbd0d5 100%
  );
  clip-path: polygon(0 0, 100% 0, 96% 100%, 0 100%);
  box-shadow: 0 1px 2px #68081855;
}

/* Logo */
#vpostIntro .truck-logo {
  position: absolute;
  z-index: 4;
  top: 22px;
  left: 8px;
  color: #fff;
  font-family: Arial, Helvetica, sans-serif;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: -.45px;
  white-space: nowrap;
  text-shadow:
    0 1px 1px #750817,
    1px 1px 2px #750817;
}

/* Đèn hậu */
#vpostIntro .truck-rear-light {
  position: absolute;
  left: -3px;
  bottom: 3px;
  width: 4px;
  height: 17px;
  border: 1px solid #7f1020;
  border-radius: 1px;
  background: linear-gradient(90deg, #ffb0a7, #e31b32);
  box-shadow: 1px 0 2px #51000b55;
}

/* Gầm xe */
#vpostIntro .truck-chassis {
  position: absolute;
  z-index: 3;
  left: 8px;
  bottom: 21px;
  width: 218px;
  height: 8px;
  border-radius: 1px;
  background: linear-gradient(
    180deg,
    #525963,
    #171b22 55%,
    #080b10
  );
  box-shadow: 0 2px 1px #0005;
}

#vpostIntro .truck-chassis::before {
  content: "";
  position: absolute;
  left: 35px;
  top: -4px;
  width: 113px;
  height: 5px;
  background: linear-gradient(#4c535d, #171b21);
}

/* Cabin */
#vpostIntro .truck-cab {
  position: absolute;
  z-index: 4;
  left: 158px;
  bottom: 25px;
  width: 76px;
  height: 64px;
  border: 1px solid #a40d21;
  border-radius: 5px 13px 2px 2px;
  background: linear-gradient(
    100deg,
    #ff5a4e 0%,
    #f3333c 28%,
    #df1c30 67%,
    #b90d27 100%
  );
  box-shadow:
    inset 3px 0 4px #ffffff20,
    inset -5px 0 5px #7c071b35,
    inset 0 -4px 0 #970b20;
}

/* Viền nóc cabin */
#vpostIntro .truck-cab::before {
  content: "";
  position: absolute;
  top: -4px;
  left: 7px;
  right: 3px;
  height: 5px;
  border: 1px solid #aeb6c0;
  border-radius: 4px 10px 0 0;
  background: linear-gradient(#fff, #d5dbe1 55%, #8e98a3);
}

/* Phần đầu xe bo tròn */
#vpostIntro .truck-cab::after {
  content: "";
  position: absolute;
  z-index: 1;
  right: -1px;
  top: 25px;
  width: 5px;
  height: 30px;
  border-radius: 2px 0 0 2px;
  background: linear-gradient(90deg, #c8102e, #a70c22);
}

/* Mái che trên kính */
#vpostIntro .truck-visor {
  position: absolute;
  z-index: 4;
  top: 3px;
  right: 3px;
  width: 50px;
  height: 5px;
  border-radius: 2px 8px 0 0;
  background: linear-gradient(#ff7869, #d91a30);
}

/* Kính chắn gió */
#vpostIntro .truck-window {
  position: absolute;
  z-index: 5;
  top: 8px;
  right: 5px;
  width: 47px;
  height: 25px;
  overflow: hidden;
  border: 2px solid #e6ebef;
  border-radius: 3px 9px 2px 3px;
  background: linear-gradient(
    130deg,
    #d9f3ff 0%,
    #a3d0e3 25%,
    #608da7 65%,
    #29495f 100%
  );
  box-shadow:
    inset 0 0 0 1px #263d50,
    inset 3px 2px 3px #ffffff70;
}

#vpostIntro .truck-window::before {
  content: "";
  position: absolute;
  top: 0;
  left: 27px;
  width: 2px;
  height: 100%;
  background: #293f50aa;
}

#vpostIntro .truck-window::after {
  content: "";
  position: absolute;
  top: -5px;
  left: 7px;
  width: 7px;
  height: 40px;
  background: #ffffff50;
  transform: rotate(28deg);
}

/* Cửa cabin */
#vpostIntro .truck-door {
  position: absolute;
  left: 8px;
  top: 30px;
  width: 35px;
  height: 26px;
  border-left: 1px solid #ffffff40;
  border-right: 1px solid #8e0b1c70;
  border-bottom: 1px solid #ffffff30;
  border-radius: 1px 1px 3px 3px;
  background: linear-gradient(90deg, #ffffff08, #8d0b1c10);
}

/* Tay nắm cửa */
#vpostIntro .truck-door-handle {
  position: absolute;
  z-index: 5;
  left: 14px;
  top: 34px;
  width: 9px;
  height: 2px;
  border-radius: 2px;
  background: #e6c7c9;
  box-shadow: 0 1px 1px #640716;
}

/* Bậc lên xuống */
#vpostIntro .truck-step {
  position: absolute;
  left: 11px;
  bottom: 1px;
  width: 27px;
  height: 4px;
  border: 1px solid #454c56;
  background: repeating-linear-gradient(
    90deg,
    #aeb5bd 0 3px,
    #343a43 3px 5px
  );
}

/* Gương chiếu hậu */
#vpostIntro .truck-mirror {
  position: absolute;
  z-index: 7;
  left: -5px;
  top: 15px;
  width: 10px;
  height: 12px;
