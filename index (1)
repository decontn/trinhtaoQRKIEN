    selectedIndex: -1,
    filtered: [],
    qrRequestId: 0
  };

  const fileInput = $("fileInput");

  function toast(message) {
    const el = $("toast");
    if (!el) return;

    el.textContent = message;
    el.style.display = "block";
    clearTimeout(toast.timer);
    toast.timer = setTimeout(() => {
      el.style.display = "none";
    }, 3400);
  }

  function escapeHtml(value) {
    return String(value ?? "").replace(/[&<>"']/g, c => ({
      "&": "&amp;",
      "<": "&lt;",
      ">": "&gt;",
      '"': "&quot;",
      "'": "&#39;"
    }[c]));
  }

  function cellText(value) {
    if (value === null || value === undefined) return "";
    if (value instanceof Date) return value.toLocaleDateString("vi-VN");
    return String(value).trim();
  }

  function findBillColumn(headers) {
    const normalize = s => String(s)
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/đ/g, "d")
      .replace(/[^a-z0-9]/g, "");

    const preferred = [
      "mabill", "mavandon", "mavd", "billcode", "bill",
      "trackingnumber", "trackingcode", "barcode",
      "mahanggui", "mabuugui"
    ];

    const normalized = headers.map(normalize);

    for (const name of preferred) {
      const i = normalized.indexOf(name);
      if (i >= 0) return i;
    }

    return -1;
  }

  function resetQR() {
    state.qrRequestId++;

    const container = $("qrCanvas");
    if (container) {
      container.innerHTML = "";
      container.style.display = "none";
    }

    $("qrPlaceholder").style.display = "grid";
    $("selectedBill").textContent = "Chưa chọn";
    $("qrNote").textContent =
      "Mã QR sẽ được tạo ngay khi bạn chọn một dòng có mã bill.";

    $("downloadBtn").disabled = true;
    $("printBtn").disabled = true;

    $("billDetails").innerHTML =
      '<div class="detail-row"><span>Trạng thái</span><span>Chưa chọn bill</span></div>';
  }

  function renderStats() {
    $("totalCount").textContent =
      state.rows.length.toLocaleString("vi-VN");

    $("billCount").textContent = state.rows
      .filter(r => cellText(r[state.billCol]))
      .length.toLocaleString("vi-VN");

    $("visibleCount").textContent =
      state.filtered.length.toLocaleString("vi-VN");
  }

  function setupColumnSelect() {
    const select = $("billColumn");
    select.innerHTML = "";

    state.headers.forEach((h, i) => {
      const option = document.createElement("option");
      option.value = String(i);
      option.textContent =
        `${h || "Cột " + (i + 1)}${i === state.billCol ? " (gợi ý)" : ""}`;
      select.appendChild(option);
    });

    select.disabled = !state.headers.length;

    if (state.billCol >= 0) {
      select.value = String(state.billCol);
    }

    $("columnStatus").textContent = state.billCol >= 0
      ? "Cột QR: " + (state.headers[state.billCol] ||
          `Cột ${state.billCol + 1}`)
      : "Chưa chọn cột mã bill";
  }

  function renderTable() {
    const query = $("searchInput").value
      .trim()
      .toLocaleLowerCase("vi");

    state.filtered = state.rows
      .map((row, index) => ({ row, index }))
      .filter(({ row }) =>
        !query || row.some(cell =>
          cellText(cell).toLocaleLowerCase("vi").includes(query)
        )
      );

    renderStats();

    if (!state.headers.length) {
      $("tableWrap").innerHTML =
        '<div class="empty"><div class="emoji">▤</div><strong>Chưa có dữ liệu</strong><br>Hãy tải lên file Excel để bắt đầu tạo QR.</div>';

      $("selectionHint").textContent = "Chưa chọn dòng nào";
      $("tableHint").textContent = "Hỗ trợ .xlsx, .xls và .csv";
      return;
    }

    if (!state.filtered.length) {
      $("tableWrap").innerHTML =
        '<div class="empty"><div class="emoji">⌕</div><strong>Không tìm thấy kết quả</strong><br>Thử từ khóa khác.</div>';

      $("selectionHint").textContent = "Không có dòng phù hợp";
      $("tableHint").textContent = "Không có dữ liệu phù hợp";
      return;
    }

    let html = '<table><thead><tr><th class="rownum">#</th>' +
      state.headers.map((h, i) =>
        `<th title="${escapeHtml(h)}">${escapeHtml(h || "Cột " + (i + 1))}${i === state.billCol ? " ◈" : ""}</th>`
      ).join("") +
      '</tr></thead><tbody>';

    for (const item of state.filtered) {
      const selected = item.index === state.selectedIndex;

      html += `<tr data-index="${item.index}" class="${selected ? "selected" : ""}">`;
      html += `<td class="rownum">${item.index + 1}</td>`;

      item.row.forEach((value, i) => {
        const content = escapeHtml(cellText(value));
        const label = escapeHtml(state.headers[i] || `Cột ${i + 1}`);

        html += `<td data-label="${label}" class="${i === state.billCol ? "bill-cell" : ""}" title="${content}">${content || '<span style="color:#94a3b8">—</span>'}</td>`;
      });

      html += "</tr>";
    }

    html += "</tbody></table>";
    $("tableWrap").innerHTML = html;

    $("tableWrap").querySelectorAll("tbody tr").forEach(tr => {
      tr.addEventListener("click", () =>
        selectRow(Number(tr.dataset.index))
      );
    });

    $("selectionHint").textContent = state.selectedIndex >= 0
      ? `Đang chọn dòng ${state.selectedIndex + 1}`
      : "Chưa chọn dòng nào";

    $("tableHint").textContent =
      `Hiển thị ${state.filtered.length} / ${state.rows.length} dòng`;
  }

  function waitForQR(timeoutMs = 15000) {
    if (typeof window.QRCode === "function") {
      return Promise.resolve(true);
    }

    if (window.__qrFailed) {
      return Promise.resolve(false);
    }

    return new Promise(resolve => {
      let finished = false;

      const finish = result => {
        if (finished) return;
        finished = true;

        clearTimeout(timer);
        document.removeEventListener("qr-ready", onReady);
        document.removeEventListener("libraries-failed", onFail);

        resolve(result);
      };

      const onReady = () => {
        finish(typeof window.QRCode === "function");
      };

      const onFail = () => {
        if (window.__qrFailed) finish(false);
      };

      const timer = setTimeout(() => {
        finish(typeof window.QRCode === "function");
      }, timeoutMs);

      document.addEventListener("qr-ready", onReady);
      document.addEventListener("libraries-failed", onFail);

      if (typeof window.QRCode === "function") {
        finish(true);
      }
    });
  }

  async function selectRow(index) {
    if (index < 0 || index >= state.rows.length) return;

    state.selectedIndex = index;
    renderTable();

    const row = state.rows[index];
    const bill = state.billCol >= 0
      ? cellText(row?.[state.billCol])
      : "";

    if (!bill) {
      resetQR();
      $("selectedBill").textContent = "Dòng chưa có mã bill";
      $("qrNote").textContent =
        "Dòng này không có giá trị ở cột mã bill.";

      toast("Dòng được chọn không có mã bill.");
      return;
    }

    const requestId = ++state.qrRequestId;

    $("selectedBill").textContent = bill;
    $("qrNote").textContent = "Đang tạo mã QR...";
    $("downloadBtn").disabled = true;
    $("printBtn").disabled = true;

    try {
      const ready = await waitForQR();

      if (requestId !== state.qrRequestId) return;

      if (!ready) {
        $("qrNote").textContent =
          "Không tải được thư viện QR. Hãy kiểm tra kết nối Internet.";

        toast("Thư viện QR chưa tải được. Hãy tải lại trang.");
        console.error("QRCodeJS chưa tải:", window.QRCode);
        return;
      }

      const container = $("qrCanvas");
      container.innerHTML = "";
      container.style.display = "block";

      new window.QRCode(container, {
        text: bill,
        width: 420,
        height: 420,
        colorDark: "#111827",
        colorLight: "#FFFFFF",
        correctLevel: window.QRCode.CorrectLevel.M
      });

      $("qrPlaceholder").style.display = "none";
      $("selectedBill").textContent = bill;
      $("qrNote").textContent =
        "Nội dung QR: chính xác mã bill ở trên.";

      $("printBtn").disabled = false;

      $("billDetails").innerHTML = state.headers.map((h, i) =>
        `<div class="detail-row"><span>${escapeHtml(h || "Cột " + (i + 1))}</span><span title="${escapeHtml(cellText(row[i]))}">${escapeHtml(cellText(row[i]) || "—")}</span></div>`
      ).join("");

      const downloadQR = () => {
        if (requestId !== state.qrRequestId) return;

        const qrCanvas = container.querySelector("canvas");
        const qrImage = container.querySelector("img");

        let dataUrl = "";

        if (qrCanvas) {
          dataUrl = qrCanvas.toDataURL("image/png");
        } else if (qrImage && qrImage.complete && qrImage.naturalWidth) {
          const tempCanvas = document.createElement("canvas");
          tempCanvas.width = 420;
          tempCanvas.height = 420;

          const ctx = tempCanvas.getContext("2d");
          ctx.fillStyle = "#FFFFFF";
          ctx.fillRect(0, 0, 420, 420);
          ctx.drawImage(qrImage, 0, 0, 420, 420);

          try {
            dataUrl = tempCanvas.toDataURL("image/png");
          } catch (error) {
            console.error("Không xuất được ảnh QR:", error);
          }
        }

        if (!dataUrl) return false;

        const link = document.createElement("a");
        link.download =
          `QR-${bill.replace(/[\\/:*?"<>|]/g, "_") || "bill"}.png`;
        link.href = dataUrl;
        link.click();

        return true;
      };

      const checkQR = () => {
        if (requestId !== state.qrRequestId) return;

        const qrCanvas = container.querySelector("canvas");
        const qrImage = container.querySelector("img");

        if (qrCanvas || (qrImage && qrImage.complete && qrImage.naturalWidth)) {
          $("downloadBtn").disabled = false;
          $("downloadBtn").onclick = downloadQR;
        }
      };

      setTimeout(checkQR, 100);
      setTimeout(checkQR, 500);

    } catch (error) {
      if (requestId !== state.qrRequestId) return;

      console.error("Lỗi tạo QR:", error);
      $("qrNote").textContent = "Tạo QR thất bại. Hãy thử chọn lại bill.";
      toast("Không tạo được QR. Mở F12 → Console để kiểm tra.");
    }
  }

  function loadData(headers, rows, filename) {
    if (!headers.length) {
      toast("Không tìm thấy hàng tiêu đề trong file.");
      return;
    }

    state.headers = headers.map((h, i) =>
      cellText(h) || `Cột ${i + 1}`
    );

    state.rows = rows.map(row =>
      state.headers.map((_, i) => row?.[i] ?? "")
    );

    state.sourceName = filename || "Dữ liệu mẫu";
    state.billCol = findBillColumn(state.headers);

    if (state.billCol < 0) state.billCol = 0;

    state.selectedIndex = -1;

    $("fileStatus").textContent = state.sourceName;
    $("searchInput").disabled = false;
    $("searchInput").value = "";

    setupColumnSelect();
    resetQR();
    renderTable();

    if (findBillColumn(state.headers) < 0) {
      toast("Chưa nhận diện được cột mã bill. Hãy chọn đúng cột.");
    } else {
      toast(`Đã nạp ${state.rows.length} dòng dữ liệu.`);
    }
  }

  async function readFile(file) {
    if (!file) return;

    if (!window.XLSX) {
      toast("Thư viện Excel chưa sẵn sàng. Hãy tải lại trang.");
      return;
    }

    try {
      const data = await file.arrayBuffer();

      const workbook = window.XLSX.read(data, {
        type: "array",
        cellDates: true
      });

      const first = workbook.SheetNames[0];

      if (!first) {
        toast("File không có trang tính.");
        return;
      }

      const matrix = window.XLSX.utils.sheet_to_json(
        workbook.Sheets[first],
        { header: 1, defval: "", raw: false }
      );

      const nonEmpty = matrix.filter(row =>
        row.some(v => cellText(v) !== "")
      );

      if (nonEmpty.length < 2) {
        toast("File cần có hàng tiêu đề và ít nhất một dòng dữ liệu.");
        return;
      }

      loadData(nonEmpty[0], nonEmpty.slice(1), file.name);
    } catch (error) {
      console.error("Lỗi đọc Excel:", error);
      toast("Không đọc được file. Hãy thử lưu lại dạng .xlsx hoặc .csv.");
    } finally {
      fileInput.value = "";
    }
  }

  fileInput.addEventListener("change", event => {
    readFile(event.target.files[0]);
  });

  $("searchInput").addEventListener("input", renderTable);

  $("billColumn").addEventListener("change", event => {
    state.billCol = Number(event.target.value);
    state.selectedIndex = -1;

    resetQR();

    $("columnStatus").textContent =
      "Cột QR: " +
      (state.headers[state.billCol] || `Cột ${state.billCol + 1}`);

    renderTable();
    renderStats();

    toast("Đã đổi cột dùng để tạo QR.");
  });

  $("downloadBtn").addEventListener("click", () => {
    if (state.selectedIndex < 0 || $("downloadBtn").disabled) return;
    $("downloadBtn").onclick?.();
  });

  $("printBtn").addEventListener("click", () => {
    if (!$("printBtn").disabled) window.print();
  });

  $("clearBtn").addEventListener("click", () => {
    state.headers = [];
    state.rows = [];
    state.sourceName = "";
    state.billCol = -1;
    state.selectedIndex = -1;
    state.filtered = [];

    $("fileStatus").textContent = "Chưa có file nào được tải lên";
    $("searchInput").value = "";
    $("searchInput").disabled = true;

    $("billColumn").innerHTML =
      '<option value="">Chọn cột mã bill</option>';
    $("billColumn").disabled = true;

    $("columnStatus").textContent = "Cột QR: chưa xác định";
    $("tableHint").textContent = "Hỗ trợ .xlsx, .xls và .csv";
    $("selectionHint").textContent = "Chưa chọn dòng nào";

    resetQR();
    renderTable();
    renderStats();

    toast("Đã xóa dữ liệu khỏi phiên làm việc.");
  });

  $("sampleBtn").addEventListener("click", () => {
    loadData(
      ["Mã bill / Mã vận đơn", "Người nhận", "Khu vực", "Trạng thái"],
      [
        ["VT001234", "Nguyễn Văn An", "Quận 1", "Đang giao"],
        ["VT001235", "Trần Thị Bình", "Quận 3", "Chờ phát"],
        ["VT001236", "Lê Minh Cường", "Thủ Đức", "Đã tiếp nhận"],
        ["VT001237", "Phạm Thu Hà", "Quận 7", "Đang giao"],
        ["VT001238", "Đỗ Quốc Huy", "Gò Vấp", "Chờ phát"]
      ],
      "Dữ liệu mẫu"
    );
  });

  function updateLibraryStatus() {
    if (window.__qrReady && window.__xlsxReady) {
      const current = $("fileStatus").textContent;

      if (
        current.includes("Đang tải thư viện") ||
        current.includes("Không tải được thư viện")
      ) {
        $("fileStatus").textContent =
          "Thư viện đã sẵn sàng — có thể tải Excel";
      }
    }
  }

  document.addEventListener("qr-ready", updateLibraryStatus);
  document.addEventListener("xlsx-ready", updateLibraryStatus);

  document.addEventListener("libraries-failed", () => {
    if (window.__qrFailed || window.__xlsxFailed) {
      $("fileStatus").textContent =
        "Không tải được thư viện; hãy kiểm tra CDN hoặc kết nối.";

      toast("Không tải được thư viện. Mở F12 → Console để kiểm tra.");
    }
  });

  if (!window.XLSX || !window.QRCode) {
    $("fileStatus").textContent = "Đang tải thư viện Excel và QR…";
  }

  resetQR();
  renderTable();
  renderStats();
})();

/* ===== ĐIỀU KHIỂN INTRO BILL QR MANAGER ===== */
(function () {
  const intro = document.getElementById("vpostIntro");
  const startBtn = document.getElementById("vpostIntroStart");
  const skipBtn = document.getElementById("vpostIntroSkip");

  if (!intro || !startBtn || !skipBtn) return;

  let closed = false;

  function closeIntro() {
    if (closed) return;
    closed = true;

    intro.classList.add("intro-exit");
    intro.setAttribute("aria-hidden", "true");

    // Không xóa phần intro ngay để hiệu ứng chuyển cảnh hoàn tất.
    window.setTimeout(function () {
      intro.style.display = "none";
    }, 600);
  }

  startBtn.addEventListener("click", closeIntro);
  skipBtn.addEventListener("click", closeIntro);

  // Nhấn Escape để bỏ qua intro.
  document.addEventListener("keydown", function (event) {
    if (!closed && event.key === "Escape") {
      closeIntro();
    }
  });

  // Hỗ trợ người dùng dùng bàn phím để chọn nút.
  intro.addEventListener("keydown", function (event) {
    if (event.key === "Enter" &&
        event.target === intro) {
      closeIntro();
    }
  });
})();

</script>


